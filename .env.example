# ---- Supabase (Project settings -> API) ----
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. Never prefix with VITE_. Used by the inquiry server function so
# submissions can be inserted while RLS keeps the table private.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Cloudinary (Dashboard -> Product environment) ----
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=pranam_unsigned

# ---- Admin panel (/admin) ----
# Simple shared password gate for the content admin panel. Defaults to
# "admin123" if unset — change this before deploying.
VITE_ADMIN_PASSWORD=admin123

# ---- Meta (Facebook) Pixel (business.facebook.com -> Events Manager) ----
# Leave unset to disable pixel tracking entirely — nothing loads without it.
VITE_META_PIXEL_ID=
